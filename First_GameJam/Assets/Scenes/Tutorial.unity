  m_Script: {fileID: 11500000, guid: 7119011c4856538469278345b53a7364, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  healthUI: {fileID: 123753355}
  gameTimer: {fileID: 183424120}
  dialogueScreen: {fileID: 1115926057}
  textComponent: {fileID: 1722575621}
  lines:
  - 'You: Dad!  Where are you?'
  - 'Mysterious Voice:  Boy! '
  - 'You: Who are you?'
  - 'Mysterious Voice:  I am the God of Time, boy.'
  - "You: My dad\u2026 Where is he?"
  - 'Mysterious Voice: He is trapped beyond time.'
  - 'You: What do you mean?'
  - 'Mysterious Voice: Time has taken him from you.'
  - "You: Then I\u2019ll bring him back."
  - 'Mysterious Voice: Then take this watch. Its power can bend time itself.'
  - "You: This\u2026 can control time?"
  - "Mysterious Voice: Yes. But remember, boy\u2026 every time you use it, you will
    pay the price."
  textSpeed: 0.0001
